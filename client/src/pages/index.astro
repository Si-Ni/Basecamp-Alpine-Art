---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import '../styles/index.css';

const artworks = [
  {
    title: 'Ethereal Dreams',
    image: 'https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?w=800&q=80',
    year: '2024',
    medium: 'Öl auf Leinwand',
    dimensions: '100 × 80 cm',
    category: 'painting',
    price: 2500,
    sold: false
  },
  {
    title: 'Urban Solitude',
    image: 'https://images.unsplash.com/photo-1547826039-bfc35e0f1ea8?w=800&q=80',
    year: '2024',
    medium: 'Acryl',
    dimensions: '120 × 90 cm',
    category: 'painting',
    price: 3200,
    sold: false
  },
  {
    title: 'Abstract Emotions',
    image: 'https://images.unsplash.com/photo-1561214115-f2f134cc4912?w=800&q=80',
    year: '2023',
    medium: 'Mischtechnik',
    dimensions: '90 × 90 cm',
    category: 'abstract',
    price: 1800,
    sold: true
  }
];
---

<Layout title="Art Portfolio - Startseite">
  <section class="hero">
    <h1>Ausgewählte Werke</h1>
    <p class="subtitle">Eine Sammlung von Gemälden, die das Zusammenspiel von Emotion, Farbe und Form erkunden.</p>
  </section>

  <section class="gallery">
    {artworks.map((artwork) => (
      <ArtworkCard {...artwork} />
    ))}
  </section>
</Layout>