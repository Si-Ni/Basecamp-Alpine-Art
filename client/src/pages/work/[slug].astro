---
// pages/work/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkDetail from '../../components/ArtworkDetail';

export async function getStaticPaths() {
  const artworks = [
    {
      slug: 'ethereal-dreams',
      title: 'Ethereal Dreams',
      image: 'https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?w=1200&q=80',
      year: '2024',
      medium: 'Öl auf Leinwand',
      dimensions: '100 × 80 cm',
      category: 'painting',
      contentCategory: 'flowers',
      format: 'vertical',
      price: 2500,
      sold: false,
      description: 'Ein faszinierendes Werk, das die zarte Schönheit von Blumen in abstrahierter Form einfängt. Die lebendigen Farben und die fließende Komposition schaffen eine traumhafte Atmosphäre.',
      tags: ['blumen', 'abstrakt', 'farben']
    },
    {
      slug: 'urban-solitude',
      title: 'Urban Solitude',
      image: 'https://images.unsplash.com/photo-1547826039-bfc35e0f1ea8?w=1200&q=80',
      year: '2024',
      medium: 'Acryl',
      dimensions: '120 × 90 cm',
      category: 'painting',
      contentCategory: 'mountains',
      format: 'vertical',
      price: 3200,
      sold: false,
      description: 'Eine kraftvolle Darstellung majestätischer Berglandschaften. Das Werk vermittelt ein Gefühl von Ruhe und Einsamkeit inmitten der Natur.',
      tags: ['berge', 'landschaft', 'natur']
    },
    {
      slug: 'abstract-emotions',
      title: 'Abstract Emotions',
      image: 'https://images.unsplash.com/photo-1561214115-f2f134cc4912?w=1200&q=80',
      year: '2023',
      medium: 'Mischtechnik',
      dimensions: '90 × 90 cm',
      category: 'abstract',
      contentCategory: 'flowers',
      format: 'square',
      price: 1800,
      sold: true,
      description: 'Eine abstrakte Komposition, die emotionale Tiefe durch geometrische Formen und Farbkontraste vermittelt.',
      tags: ['abstrakt', 'emotion', 'geometrisch']
    },
    {
      slug: 'natures-whisper',
      title: "Nature's Whisper",
      image: 'https://images.unsplash.com/photo-1578926288207-a90a5366759d?w=1200&q=80',
      year: '2023',
      medium: 'Aquarell',
      dimensions: '60 × 80 cm',
      category: 'painting',
      contentCategory: 'flowers',
      format: 'horizontal',
      price: 1200,
      sold: false,
      description: 'Zarte Aquarell-Arbeit, die die Leichtigkeit und Vergänglichkeit der Natur einfängt.',
      tags: ['blumen', 'aquarell', 'zart']
    },
    {
      slug: 'silent-reflections',
      title: 'Silent Reflections',
      image: 'https://images.unsplash.com/photo-1549887534-1541e9326642?w=1200&q=80',
      year: '2023',
      medium: 'Öl auf Leinwand',
      dimensions: '100 × 100 cm',
      category: 'painting',
      contentCategory: 'mountains',
      format: 'square',
      price: 2800,
      sold: false,
      description: 'Berge spiegeln sich in stillem Wasser – eine meditative Betrachtung von Natur und Reflexion.',
      tags: ['berge', 'reflexion', 'see']
    },
    {
      slug: 'color-symphony',
      title: 'Color Symphony',
      image: 'https://images.unsplash.com/photo-1541961017774-22349e4a1262?w=1200&q=80',
      year: '2022',
      medium: 'Acryl',
      dimensions: '150 × 100 cm',
      category: 'abstract',
      contentCategory: 'flowers',
      format: 'horizontal',
      price: 3500,
      sold: false,
      description: 'Eine dynamische Explosion von Farben, die wie eine visuelle Symphonie zusammenspielen.',
      tags: ['farben', 'symphonie', 'lebhaft']
    },
    {
      slug: 'digital-dreams',
      title: 'Digital Dreams',
      image: 'https://images.unsplash.com/photo-1557672172-298e090bd0f1?w=1200&q=80',
      year: '2024',
      medium: 'Digitale Kunst',
      dimensions: 'Digital',
      category: 'digital',
      contentCategory: 'mountains',
      format: 'vertical',
      price: 800,
      sold: false,
      description: 'Eine moderne digitale Interpretation von Berglandschaften im Zeitalter der Technologie.',
      tags: ['digital', 'modern', 'technologie']
    },
    {
      slug: 'minimalist-study',
      title: 'Minimalist Study',
      image: 'https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=1200&q=80',
      year: '2022',
      medium: 'Mischtechnik',
      dimensions: '80 × 80 cm',
      category: 'abstract',
      contentCategory: 'flowers',
      format: 'square',
      price: 1500,
      sold: true,
      description: 'Eine minimalistische Studie über Form und Leere, die die Essenz auf das Wesentliche reduziert.',
      tags: ['minimalistisch', 'einfach', 'formen']
    }
  ];

  return artworks.map((artwork) => ({
    params: { slug: artwork.slug },
    props: { artwork }
  }));
}

const { artwork } = Astro.props;
---

<BaseLayout title={`${artwork.title} - Art Portfolio`} description={artwork.description}>
  <ArtworkDetail client:load artwork={artwork} />
</BaseLayout>