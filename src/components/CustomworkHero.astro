---
// src/components/CustomworkHero.astro
// ─────────────────────────────────────────────────────────────────────────────
// Hero section for the Auftragsarbeiten page.
// Static presentational component — no props, no state.
// ─────────────────────────────────────────────────────────────────────────────
---

<section class="cwh-root" aria-labelledby="cwh-heading">

  <!-- Decorative background elements -->
  <div class="cwh-bg" aria-hidden="true">
    <div class="cwh-stroke cwh-stroke--1"></div>
    <div class="cwh-stroke cwh-stroke--2"></div>
    <div class="cwh-stroke cwh-stroke--3"></div>
    <!-- Brushstroke flourish -->
    <svg class="cwh-brush" viewBox="0 0 420 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path
        d="M 20 55 C 80 20, 160 10, 210 38 S 340 68, 400 30"
        fill="none"
        stroke="rgba(201,169,110,0.10)"
        stroke-width="28"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M 20 55 C 80 20, 160 10, 210 38 S 340 68, 400 30"
        fill="none"
        stroke="rgba(201,169,110,0.06)"
        stroke-width="3"
        stroke-linecap="round"
        stroke-dasharray="6 9"
      />
    </svg>
  </div>

  <!-- Noise grain overlay -->
  <div class="cwh-noise" aria-hidden="true"></div>

  <!-- Ornamental top rule -->
  <div class="cwh-ornament" aria-hidden="true">
    <span class="cwh-ornament__line"></span>
    <span class="cwh-ornament__glyph">✦</span>
    <span class="cwh-ornament__line cwh-ornament__line--rev"></span>
  </div>

  <div class="cwh-content">
    <p class="cwh-eyebrow">Hannah Milena Pilack</p>

    <h1 class="cwh-title" id="cwh-heading">
      <span class="cwh-title__sub">Auftrags</span><span class="cwh-title__main">arbeiten</span>
    </h1>

    <p class="cwh-tagline">
      Dein Erlebnis.<br />
      <em>Mein Pinsel.</em>
    </p>
  </div>

  <!-- Scroll indicator -->
  <div class="cwh-scroll" aria-hidden="true">
    <span class="cwh-scroll__line"></span>
  </div>

</section>

<style>
  .cwh-root {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 62vh;
    padding: 5rem 2rem 5rem;
    overflow: hidden;
    text-align: center;
    background: var(--color-bg);
  }

  /* ── Decorative strokes ── */
  .cwh-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cwh-stroke {
    position: absolute;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .cwh-stroke--1 {
    top: -20%;
    right: -8%;
    width: 28%;
    height: 115%;
    transform: rotate(9deg);
    opacity: 0.035;
  }

  .cwh-stroke--2 {
    bottom: -25%;
    left: -5%;
    width: 20%;
    height: 85%;
    transform: rotate(-7deg);
    opacity: 0.025;
  }

  .cwh-stroke--3 {
    top: 10%;
    left: 15%;
    width: 1px;
    height: 60%;
    background: linear-gradient(to bottom, transparent, rgba(201,169,110,0.15), transparent);
    opacity: 1;
  }

  /* ── Brushstroke SVG ── */
  .cwh-brush {
    position: absolute;
    bottom: 12%;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(280px, 55vw, 480px);
    opacity: 1;
    pointer-events: none;
  }

  /* ── Noise overlay ── */
  .cwh-noise {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
    opacity: 0.03;
    pointer-events: none;
  }

  /* ── Ornamental rule ── */
  .cwh-ornament {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: min(320px, 80%);
    margin-bottom: 2.5rem;
    animation: cwh-fadeUp 0.9s 0.1s both;
  }

  .cwh-ornament__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(201,169,110,0.25));
  }

  .cwh-ornament__line--rev {
    background: linear-gradient(to left, transparent, rgba(201,169,110,0.25));
  }

  .cwh-ornament__glyph {
    font-size: 0.55rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ── Content ── */
  .cwh-content {
    position: relative;
    z-index: 2;
  }

  .cwh-eyebrow {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1.6rem;
    animation: cwh-fadeUp 0.9s 0.2s both;
  }

  .cwh-title {
    font-family: var(--font-display);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0 0 1.8rem;
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.1em;
  }

  .cwh-title__sub {
    font-style: italic;
    color: var(--color-muted);
    font-size: clamp(2.8rem, 7vw, 6rem);
    animation: cwh-fadeUp 0.9s 0.35s both;
  }

  .cwh-title__main {
    font-size: clamp(2.8rem, 7vw, 6rem);
    animation: cwh-fadeUp 0.9s 0.5s both;
  }

  .cwh-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.55rem);
    font-weight: 300;
    font-style: normal;
    line-height: 1.6;
    color: var(--color-muted);
    letter-spacing: 0.03em;
    margin: 0;
    animation: cwh-fadeUp 0.9s 0.65s both;
  }

  .cwh-tagline em {
    font-style: italic;
    color: var(--color-accent);
  }

  /* ── Scroll indicator ── */
  .cwh-scroll {
    position: relative;
    z-index: 2;
    margin-top: 3rem;
    animation: cwh-fadeUp 0.9s 0.9s both;
  }

  .cwh-scroll__line {
    display: block;
    width: 1px;
    height: 60px;
    margin: 0 auto;
    background: linear-gradient(to bottom, transparent, var(--color-accent));
    animation: cwh-scrollPulse 2.2s ease-in-out infinite;
  }

  @keyframes cwh-fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes cwh-scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50%       { opacity: 1;   transform: scaleY(0.65); }
  }
</style>