---
// src/components/ImpressumContact.astro
// ─────────────────────────────────────────────────────────────────────────────
// Contact / identity block for the Impressum page.
// Shows name, address, representative and contact details in an
// editorial two-column card layout.
// ─────────────────────────────────────────────────────────────────────────────
---

<section class="ic-root" aria-label="Kontaktangaben">
  <div class="ic-inner">

    <!-- Left: large decorative initial + label -->
    <aside class="ic-aside" aria-hidden="true">
      <div class="ic-aside__initial">H</div>
      <div class="ic-aside__rule"></div>
      <p class="ic-aside__label">Verantwortlich</p>
    </aside>

    <!-- Right: info grid -->
    <div class="ic-grid">

      <div class="ic-block">
        <p class="ic-block__label">Künstlerin</p>
        <address class="ic-block__value">
          Hannah Milena Pilack<br />
          Kurfer Str. 24<br />
          83093 Bad Endorf
        </address>
      </div>

      <div class="ic-block">
        <p class="ic-block__label">E-Mail</p>
        <a class="ic-block__link" href="mailto:basecampalpineart@gmx.de">
          basecampalpineart@gmx.de</a>
      </div>

    </div>

  </div>
</section>

<style>
  .ic-root {
    padding: 0 2rem 5rem;
    max-width: 1000px;
    margin: 0 auto;
    animation: ic-fadeUp 1s 0.1s both;
  }

  .ic-inner {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 0 4rem;
    align-items: center;
    padding: 3rem;
    border: 1px solid rgba(201,169,110,0.1);
    background: rgba(201,169,110,0.02);
    border-radius: 2px;
    position: relative;
  }

  /* Gold corner accents on the card */
  .ic-inner::before,
  .ic-inner::after {
    content: '';
    position: absolute;
    width: 24px; height: 24px;
    pointer-events: none;
  }
  .ic-inner::before {
    top: -1px; left: -1px;
    border-top: 1px solid var(--color-accent);
    border-left: 1px solid var(--color-accent);
    opacity: 0.5;
  }
  .ic-inner::after {
    bottom: -1px; right: -1px;
    border-bottom: 1px solid var(--color-accent);
    border-right: 1px solid var(--color-accent);
    opacity: 0.5;
  }

  /* ── Aside ── */
  .ic-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding-top: 0.3rem;
  }

  .ic-aside__initial {
    font-family: var(--font-display);
    font-size: 6rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-accent);
    opacity: 0.15;
    letter-spacing: -0.05em;
  }

  .ic-aside__rule {
    width: 28px; height: 1px;
    background: var(--color-accent);
    opacity: 0.35;
  }

  .ic-aside__label {
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 400;
    margin: 0;
    opacity: 0.8;
  }

  /* ── Info grid ── */
  .ic-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 3rem;
  }

  .ic-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ic-block__label {
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 400;
    margin: 0;
    opacity: 0.75;
  }

  .ic-block__value {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-muted);
    font-weight: 300;
    font-style: normal;
    margin: 0;
    letter-spacing: 0.01em;
  }

  .ic-block__link {
    font-size: 0.95rem;
    color: var(--color-text);
    font-weight: 300;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding-bottom: 0.1em;
    transition: color 0.2s, border-color 0.2s;
    width: fit-content;
  }

  .ic-block__link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .ic-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem;
    }
    .ic-aside { flex-direction: row; align-items: center; }
    .ic-aside__initial { font-size: 3.5rem; }
    .ic-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  @keyframes ic-fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>