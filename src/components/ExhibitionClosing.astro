---
// src/components/ExhibitionClosing.astro
// ─────────────────────────────────────────────────────────────────────────────
// Closing quote / CTA for the Ausstellungen page.
// Mirrors AboutClosing and CustomworkClosing.
// ─────────────────────────────────────────────────────────────────────────────
---

<section class="exc-root" aria-label="Abschluss">

  <!-- Decorative full-width rule -->
  <div class="exc-rule" aria-hidden="true">
    <span class="exc-rule__line"></span>
    <span class="exc-rule__diamond">✦</span>
    <span class="exc-rule__line exc-rule__line--rev"></span>
  </div>

  <blockquote class="exc-quote">
    <p class="exc-quote__text">
      „Kunst lebt davon, gesehen zu werden"
    </p>
    <footer class="exc-quote__footer">
      <span class="exc-quote__dash" aria-hidden="true">—</span>
      <cite>Hannah Milena Pilack</cite>
    </footer>
  </blockquote>

  <!-- Links -->
  <div class="exc-actions">
    <a href="/werke" class="exc-link exc-link--primary">
      Zur Galerie
      <span class="exc-link__arrow" aria-hidden="true">→</span>
    </a>
    <a href="/kontakt" class="exc-link exc-link--secondary">
      Kontakt
    </a>
  </div>

</section>

<style>
  .exc-root {
    padding: 5rem 2rem 7rem;
    border-top: 1px solid rgba(255,255,255,0.05);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }

  /* ── Rule ── */
  .exc-rule {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: min(440px, 80%);
  }

  .exc-rule__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(201,169,110,0.2));
  }

  .exc-rule__line--rev {
    background: linear-gradient(to left, transparent, rgba(201,169,110,0.2));
  }

  .exc-rule__diamond {
    font-size: 0.55rem;
    color: var(--color-accent);
    opacity: 0.6;
    flex-shrink: 0;
  }

  /* ── Quote ── */
  .exc-quote {
    max-width: 620px;
    margin: 0;
  }

  .exc-quote__text {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3.1vw, 2.1rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0 0 1.2rem;
    letter-spacing: 0.01em;
  }

  .exc-quote__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(122,118,112,0.4);
    font-style: normal;
  }

  .exc-quote__dash { color: var(--color-accent); opacity: 0.4; }
  cite { font-style: normal; }

  /* ── Action links ── */
  .exc-actions {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .exc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 400;
    text-decoration: none;
    padding: 0.75rem 1.8rem;
    border-radius: 3px;
    transition: background 0.25s, border-color 0.25s, color 0.25s, transform 0.2s;
  }

  .exc-link--primary {
    color: var(--color-accent);
    border: 1px solid rgba(201,169,110,0.3);
  }

  .exc-link--primary:hover {
    background: rgba(201,169,110,0.06);
    border-color: rgba(201,169,110,0.55);
    transform: translateY(-2px);
  }

  .exc-link--secondary {
    color: rgba(122,118,112,0.55);
    border: 1px solid rgba(255,255,255,0.06);
  }

  .exc-link--secondary:hover {
    color: var(--color-muted);
    border-color: rgba(255,255,255,0.12);
    transform: translateY(-2px);
  }

  .exc-link__arrow { transition: transform 0.25s; }
  .exc-link--primary:hover .exc-link__arrow { transform: translateX(4px); }
</style>