---
// src/components/ExhibitionFuture.astro
// ─────────────────────────────────────────────────────────────────────────────
// "Stay tuned" upcoming exhibitions section for the Ausstellungen page.
// Sidebar layout matching ExhibitionPast — chapter II, atmospheric placeholder.
// ─────────────────────────────────────────────────────────────────────────────
---

<section class="exf-root" aria-labelledby="exf-heading">
  <div class="exf-inner">

    <!-- ── Sidebar ── -->
    <aside class="exf-sidebar">
      <div class="exf-chapter">
        <span class="exf-chapter__num" aria-hidden="true">II</span>
        <span class="exf-chapter__rule" aria-hidden="true"></span>
        <p class="exf-chapter__label" id="exf-heading">Kommende Ausstellungen</p>
      </div>
      <blockquote class="exf-pullquote">
        <p>„Jedes Bild wartet auf den richtigen Raum."</p>
      </blockquote>
    </aside>

    <!-- ── Body ── -->
    <div class="exf-body">

      <!-- Atmospheric placeholder card -->
      <div class="exf-card" aria-label="Nächste Ausstellung – noch nicht angekündigt">

        <!-- Decorative background canvas-texture lines -->
        <div class="exf-card__lines" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>

        <div class="exf-card__content">

          <div class="exf-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" fill="none">
              <!-- Simplified frame / easel icon -->
              <rect x="8"  y="6"  width="32" height="28" rx="1" stroke="rgba(201,169,110,0.35)" stroke-width="1"/>
              <rect x="13" y="11" width="22" height="18" rx="0.5" stroke="rgba(201,169,110,0.2)" stroke-width="0.75"/>
              <!-- Easel legs -->
              <line x1="24" y1="34" x2="24" y2="43" stroke="rgba(201,169,110,0.25)" stroke-width="1" stroke-linecap="round"/>
              <line x1="24" y1="43" x2="18" y2="43" stroke="rgba(201,169,110,0.2)"  stroke-width="0.75" stroke-linecap="round"/>
              <line x1="24" y1="43" x2="30" y2="43" stroke="rgba(201,169,110,0.2)"  stroke-width="0.75" stroke-linecap="round"/>
              <!-- Sparkle -->
              <circle cx="37" cy="9" r="1.5" fill="rgba(201,169,110,0.4)"/>
            </svg>
          </div>

          <h2 class="exf-title">Nächste Ausstellung</h2>

          <p class="exf-sub">Noch in Planung</p>

          <div class="exf-divider" aria-hidden="true">
            <span class="exf-divider__line"></span>
            <span class="exf-divider__glyph">✦</span>
            <span class="exf-divider__line exf-divider__line--rev"></span>
          </div>

          <p class="exf-text">
            Neue Ausstellungen sind in Vorbereitung.
          </p>

          <!-- Animated "stay tuned" badge -->
          <div class="exf-tuned" aria-label="Stay tuned">
            <span class="exf-tuned__pulse" aria-hidden="true"></span>
            Stay tuned
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .exf-root {
    padding: 3rem 2rem 5rem;
    max-width: 1140px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }

  .exf-inner {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 0 5rem;
    align-items: start;
  }

  /* ── Sidebar ── */
  .exf-sidebar {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
  }

  .exf-chapter { display: flex; flex-direction: column; gap: 0.7rem; }

  .exf-chapter__num {
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-accent);
    opacity: 0.18;
    letter-spacing: -0.03em;
  }

  .exf-chapter__rule {
    display: block;
    width: 28px;
    height: 1px;
    background: var(--color-accent);
    opacity: 0.4;
  }

  .exf-chapter__label {
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 400;
    margin: 0;
  }

  .exf-pullquote {
    margin: 0;
    padding: 0 0 0 1.2rem;
    border-left: 1px solid rgba(201,169,110,0.25);
  }

  .exf-pullquote p {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0;
  }

  /* ── Body ── */
  .exf-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 0.4rem;
  }

  /* ── Placeholder card ── */
  .exf-card {
    position: relative;
    overflow: hidden;
    padding: 3.5rem 3rem;
    border: 1px solid rgba(201,169,110,0.1);
    background: rgba(201,169,110,0.018);
    border-radius: 2px;
    box-shadow: inset 0 1px 0 rgba(201,169,110,0.05), 0 4px 24px rgba(0,0,0,0.2);
    text-align: center;
  }

  /* Subtle canvas-texture horizontal lines */
  .exf-card__lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
  }

  .exf-card__lines span {
    display: block;
    width: 100%;
    height: 1px;
    background: linear-gradient(to right, transparent 5%, rgba(201,169,110,0.04) 35%, rgba(201,169,110,0.04) 65%, transparent 95%);
  }

  /* Top-right corner accent */
  .exf-card::before {
    content: '';
    position: absolute;
    top: -1px; right: -1px;
    width: 32px; height: 32px;
    border-top: 1px solid rgba(201,169,110,0.32);
    border-right: 1px solid rgba(201,169,110,0.32);
    pointer-events: none;
  }

  /* Bottom-left corner accent */
  .exf-card::after {
    content: '';
    position: absolute;
    bottom: -1px; left: -1px;
    width: 32px; height: 32px;
    border-bottom: 1px solid rgba(201,169,110,0.32);
    border-left: 1px solid rgba(201,169,110,0.32);
    pointer-events: none;
  }

  .exf-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
  }

  /* ── Easel icon ── */
  .exf-icon {
    width: 52px;
    height: 52px;
    opacity: 0.7;
  }

  /* ── Title ── */
  .exf-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0;
  }

  .exf-sub {
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(201,169,110,0.45);
    font-weight: 400;
    margin: 0;
  }

  /* ── Inline divider ── */
  .exf-divider {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    max-width: 320px;
  }

  .exf-divider__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(201,169,110,0.15));
  }

  .exf-divider__line--rev {
    background: linear-gradient(to left, transparent, rgba(201,169,110,0.15));
  }

  .exf-divider__glyph {
    font-size: 0.5rem;
    color: var(--color-accent);
    opacity: 0.45;
    flex-shrink: 0;
  }

  /* ── Body text ── */
  .exf-text {
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--color-muted);
    font-weight: 300;
    letter-spacing: 0.01em;
    max-width: 460px;
    margin: 0;
  }

  /* ── Stay tuned badge with pulse ── */
  .exf-tuned {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.68rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 400;
    padding: 0.55rem 1.3rem;
    border: 1px solid rgba(201,169,110,0.22);
    border-radius: 50px;
    background: rgba(201,169,110,0.04);
  }

  .exf-tuned__pulse {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.7;
    position: relative;
    flex-shrink: 0;
  }

  /* Pulse ring animation */
  .exf-tuned__pulse::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid rgba(201,169,110,0.45);
    animation: exf-pulse 2s ease-out infinite;
  }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .exf-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .exf-sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 2rem;
    }

    .exf-chapter {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }

    .exf-card { padding: 2.5rem 1.8rem; }
  }

  @keyframes exf-pulse {
    0%   { transform: scale(1);   opacity: 0.5; }
    70%  { transform: scale(2.4); opacity: 0; }
    100% { transform: scale(2.4); opacity: 0; }
  }
</style>