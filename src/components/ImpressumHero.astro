---
// src/components/ImpressumHero.astro
// ─────────────────────────────────────────────────────────────────────────────
// Compact hero for the Impressum page.
// Smaller than the main page heroes — legal pages warrant less height,
// but still carry the full visual language of the site.
// ─────────────────────────────────────────────────────────────────────────────
---

<section class="ih-root" aria-labelledby="ih-heading">

  <div class="ih-bg" aria-hidden="true">
    <div class="ih-stroke ih-stroke--1"></div>
    <div class="ih-stroke ih-stroke--2"></div>
  </div>
  <div class="ih-noise" aria-hidden="true"></div>

  <div class="ih-ornament" aria-hidden="true">
    <span class="ih-ornament__line"></span>
    <span class="ih-ornament__glyph">✦</span>
    <span class="ih-ornament__line ih-ornament__line--rev"></span>
  </div>

  <div class="ih-content">
    <p class="ih-eyebrow">Hannah Milena Pilack</p>
    <h1 class="ih-title" id="ih-heading">
      <span class="ih-title__light">Im</span><span class="ih-title__main">pressum</span>
    </h1>
    <p class="ih-sub">Angaben gemäß § 5 DDG</p>
  </div>

</section>

<style>
  .ih-root {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 42vh;
    padding: 8rem 2rem 4rem;
    overflow: hidden;
    text-align: center;
    background: var(--color-bg);
  }

  .ih-bg { position: absolute; inset: 0; pointer-events: none; }

  .ih-stroke {
    position: absolute;
    border-radius: 2px;
    background: var(--color-accent);
  }
  .ih-stroke--1 {
    top: -20%; left: -6%;
    width: 22%; height: 120%;
    transform: rotate(-8deg);
    opacity: 0.028;
  }
  .ih-stroke--2 {
    bottom: -20%; right: -4%;
    width: 16%; height: 90%;
    transform: rotate(6deg);
    opacity: 0.02;
  }

  .ih-noise {
    position: absolute; inset: 0; z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
    opacity: 0.028;
    pointer-events: none;
  }

  .ih-ornament {
    position: relative; z-index: 2;
    display: flex; align-items: center; gap: 0.8rem;
    width: min(300px, 80%);
    margin-bottom: 2rem;
    animation: ih-fadeUp 0.9s 0.1s both;
  }
  .ih-ornament__line {
    flex: 1; height: 1px;
    background: linear-gradient(to right, transparent, rgba(201,169,110,0.22));
  }
  .ih-ornament__line--rev {
    background: linear-gradient(to left, transparent, rgba(201,169,110,0.22));
  }
  .ih-ornament__glyph { font-size: 0.52rem; color: var(--color-accent); flex-shrink: 0; }

  .ih-content { position: relative; z-index: 2; }

  .ih-eyebrow {
    font-size: 0.68rem; font-weight: 400;
    letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1.2rem;
    animation: ih-fadeUp 0.9s 0.2s both;
  }

  .ih-title {
    font-family: var(--font-display);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0 0 1.4rem;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.08em;
  }

  .ih-title__light {
    font-style: italic;
    color: var(--color-muted);
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    animation: ih-fadeUp 0.9s 0.35s both;
  }
  .ih-title__main {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    animation: ih-fadeUp 0.9s 0.5s both;
  }

  .ih-sub {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 300;
    margin: 0;
    animation: ih-fadeUp 0.9s 0.65s both;
  }

  @keyframes ih-fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>