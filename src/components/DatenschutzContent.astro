            <li>Bestandsdaten</li><li>Zahlungsdaten</li><li>Kontaktdaten</li>
            <li>Inhaltsdaten</li><li>Vertragsdaten</li><li>Nutzungsdaten</li>
            <li>Meta-, Kommunikations- und Verfahrensdaten</li><li>Protokolldaten</li>
          </ul>
        </div>

