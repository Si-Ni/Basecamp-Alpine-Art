---
// src/components/AboutClosing.astro
// ─────────────────────────────────────────────────────────────────────────────
// Closing quote / CTA section for the Über mich page.
// Matches the quote-section pattern established in kontakt.astro.
// ─────────────────────────────────────────────────────────────────────────────
---

<section class="ac-root" aria-label="Abschluss">

  <!-- Decorative full-width rule -->
  <div class="ac-rule" aria-hidden="true">
    <span class="ac-rule__line"></span>
    <span class="ac-rule__diamond">✦</span>
    <span class="ac-rule__line ac-rule__line--rev"></span>
  </div>

  <blockquote class="ac-quote">
    <p class="ac-quote__text">
      „In jedem Bild steckt ein Berg –<br />
      und in jedem Berg ein Bild."
    </p>
    <footer class="ac-quote__footer">
      <span class="ac-quote__dash" aria-hidden="true">—</span>
      <cite>Hannah Milena Pilack</cite>
    </footer>
  </blockquote>

  <!-- Contact nudge -->
  <div class="ac-contact">
    <p class="ac-contact__text">Interesse an einem Auftragswerk?</p>
    <a href="/kontakt" class="ac-contact__link">
      Schreib mir
      <span class="ac-contact__arrow" aria-hidden="true">→</span>
    </a>
  </div>

</section>

<style>
  .ac-root {
    padding: 5rem 2rem 7rem;
    border-top: 1px solid rgba(255,255,255,0.05);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    animation: ac-fadeUp 1s 0.2s both;
  }

  /* ── Rule ── */
  .ac-rule {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: min(440px, 80%);
  }

  .ac-rule__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(201,169,110,0.2));
  }

  .ac-rule__line--rev {
    background: linear-gradient(to left, transparent, rgba(201,169,110,0.2));
  }

  .ac-rule__diamond {
    font-size: 0.55rem;
    color: var(--color-accent);
    opacity: 0.6;
    flex-shrink: 0;
  }

  /* ── Quote ── */
  .ac-quote {
    max-width: 600px;
    margin: 0;
  }

  .ac-quote__text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0 0 1.2rem;
    letter-spacing: 0.01em;
  }

  .ac-quote__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(122,118,112,0.4);
    font-style: normal;
  }

  .ac-quote__dash {
    color: var(--color-accent);
    opacity: 0.4;
  }

  cite { font-style: normal; }

  /* ── Contact nudge ── */
  .ac-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .ac-contact__text {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(122,118,112,0.5);
    font-weight: 300;
    margin: 0;
  }

  .ac-contact__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.75rem 1.8rem;
    border: 1px solid rgba(201,169,110,0.3);
    border-radius: 3px;
    transition: background 0.25s, border-color 0.25s, transform 0.2s;
  }

  .ac-contact__link:hover {
    background: rgba(201,169,110,0.06);
    border-color: rgba(201,169,110,0.55);
    transform: translateY(-2px);
  }

  .ac-contact__arrow {
    transition: transform 0.25s;
  }

  .ac-contact__link:hover .ac-contact__arrow {
    transform: translateX(4px);
  }

  @keyframes ac-fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>