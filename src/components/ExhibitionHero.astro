---
// src/components/ExhibitionHero.astro
// ─────────────────────────────────────────────────────────────────────────────
// Hero section for the Ausstellungen page.
// Static presentational component — no props, no state.
// ─────────────────────────────────────────────────────────────────────────────
---

<section class="exh-root" aria-labelledby="exh-heading">

  <!-- Decorative background elements -->
  <div class="exh-bg" aria-hidden="true">
    <div class="exh-stroke exh-stroke--1"></div>
    <div class="exh-stroke exh-stroke--2"></div>
    <div class="exh-stroke exh-stroke--3"></div>
  </div>

  <!-- Noise grain overlay -->
  <div class="exh-noise" aria-hidden="true"></div>

  <!-- Ornamental top rule -->
  <div class="exh-ornament" aria-hidden="true">
    <span class="exh-ornament__line"></span>
    <span class="exh-ornament__glyph">✦</span>
    <span class="exh-ornament__line exh-ornament__line--rev"></span>
  </div>

  <div class="exh-content">
    <p class="exh-eyebrow">Hannah Milena Pilack</p>

    <h1 class="exh-title" id="exh-heading">
      <span class="exh-title__main">Ausstellungen</span>
    </h1>

    <p class="exh-tagline">
      Kunst braucht<br />
      <em>einen Raum.</em>
    </p>
  </div>

  <!-- Scroll indicator -->
  <div class="exh-scroll" aria-hidden="true">
    <span class="exh-scroll__line"></span>
  </div>

</section>

<style>
  .exh-root {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 62vh;
    padding: 5rem 2rem 5rem;
    overflow: hidden;
    text-align: center;
    background: var(--color-bg);
  }

  /* ── Decorative strokes ── */
  .exh-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .exh-stroke {
    position: absolute;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .exh-stroke--1 {
    top: -20%;
    left: -6%;
    width: 22%;
    height: 110%;
    transform: rotate(-8deg);
    opacity: 0.03;
  }

  .exh-stroke--2 {
    bottom: -20%;
    right: -4%;
    width: 18%;
    height: 80%;
    transform: rotate(6deg);
    opacity: 0.022;
  }

  .exh-stroke--3 {
    top: 8%;
    right: 18%;
    width: 1px;
    height: 55%;
    background: linear-gradient(to bottom, transparent, rgba(201,169,110,0.15), transparent);
    opacity: 1;
  }

  /* ── Noise overlay ── */
  .exh-noise {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
    opacity: 0.03;
    pointer-events: none;
  }

  /* ── Ornamental rule ── */
  .exh-ornament {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: min(320px, 80%);
    margin-bottom: 2.5rem;
    animation: exh-fadeUp 0.9s 0.1s both;
  }

  .exh-ornament__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(201,169,110,0.25));
  }

  .exh-ornament__line--rev {
    background: linear-gradient(to left, transparent, rgba(201,169,110,0.25));
  }

  .exh-ornament__glyph {
    font-size: 0.55rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ── Content ── */
  .exh-content {
    position: relative;
    z-index: 2;
  }

  .exh-eyebrow {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1.6rem;
    animation: exh-fadeUp 0.9s 0.2s both;
  }

  .exh-title {
    font-family: var(--font-display);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0 0 1.8rem;
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.1em;
  }

  .exh-title__main {
    font-size: clamp(2.8rem, 7vw, 6rem);
    animation: exh-fadeUp 0.9s 0.5s both;
  }

  .exh-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.55rem);
    font-weight: 300;
    font-style: normal;
    line-height: 1.6;
    color: var(--color-muted);
    letter-spacing: 0.03em;
    margin: 0;
    animation: exh-fadeUp 0.9s 0.65s both;
  }

  .exh-tagline em {
    font-style: italic;
    color: var(--color-accent);
  }

  /* ── Scroll indicator ── */
  .exh-scroll {
    position: relative;
    z-index: 2;
    margin-top: 3rem;
    animation: exh-fadeUp 0.9s 0.9s both;
  }

  .exh-scroll__line {
    display: block;
    width: 1px;
    height: 60px;
    margin: 0 auto;
    background: linear-gradient(to bottom, transparent, var(--color-accent));
    animation: exh-scrollPulse 2.2s ease-in-out infinite;
  }

  @keyframes exh-fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes exh-scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50%       { opacity: 1;   transform: scaleY(0.65); }
  }
</style>