---
import '../styles/artworkcard.css';

interface Props {
  title: string;
  image: string;
  year?: string;
  medium?: string;
  dimensions?: string;
  category?: string;
  price?: number;
  sold?: boolean;
}

const { title, image, year, medium, dimensions, price, sold = false } = Astro.props;
---

<article class="artwork-card">
  <a href={`/work/${title.toLowerCase().replace(/\s+/g, '-')}`} class="artwork-link">
    <div class="image-container">
      <img src={image} alt={title} loading="lazy" />
      {sold && <div class="sold-badge">Verkauft</div>}
    </div>
    <div class="artwork-info">
      <h3>{title}</h3>
      <div class="artwork-meta">
        {year && <span>{year}</span>}
        {medium && <span>{medium}</span>}
        {dimensions && <span>{dimensions}</span>}
      </div>
      {price && (
        <div class="artwork-price">
          {sold ? (
            <span class="price-sold">Verkauft</span>
          ) : (
            <span class="price-amount">€{price.toLocaleString('de-DE')}</span>
          )}
        </div>
      )}
    </div>
  </a>
</article>