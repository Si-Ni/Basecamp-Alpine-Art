---
interface Props {
  title: string;
  image: string;
  year?: string;
  medium?: string;
  dimensions?: string;
  category?: string;
  price?: number;
  sold?: boolean;
}

const { title, image, year, medium, dimensions, price, sold = false } = Astro.props;
---

<article class="artwork-card">
  <a href={`/work/${title.toLowerCase().replace(/\s+/g, '-')}`} class="artwork-link">
    <div class="image-container">
      <img src={image} alt={title} loading="lazy" />
      {sold && <div class="sold-badge">Verkauft</div>}
    </div>
    <div class="artwork-info">
      <h3>{title}</h3>
      <div class="artwork-meta">
        {year && <span>{year}</span>}
        {medium && <span>{medium}</span>}
        {dimensions && <span>{dimensions}</span>}
      </div>
      {price && (
        <div class="artwork-price">
          {sold ? (
            <span class="price-sold">Verkauft</span>
          ) : (
            <span class="price-amount">€{price.toLocaleString('de-DE')}</span>
          )}
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .artwork-card {
    position: relative;
    transition: transform 0.3s ease;
  }

  .artwork-link {
    display: block;
  }

  .image-container {
    position: relative;
    overflow: hidden;
    background-color: var(--color-border);
    aspect-ratio: 3/4;
    margin-bottom: 1rem;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, opacity 0.3s ease;
  }

  .sold-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    backdrop-filter: blur(5px);
  }

  .artwork-card:hover img {
    transform: scale(1.02);
    opacity: 0.9;
  }

  .artwork-info {
    padding: 0.5rem 0;
  }

  .artwork-info h3 {
    font-size: 1.1rem;
    font-weight: 400;
    margin-bottom: 0.25rem;
  }

  .artwork-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    opacity: 0.6;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .artwork-meta span:not(:last-child)::after {
    content: '·';
    margin-left: 0.5rem;
  }

  .artwork-price {
    margin-top: 0.75rem;
    font-size: 1rem;
    font-weight: 500;
  }

  .price-amount {
    color: var(--color-accent);
  }

  .price-sold {
    opacity: 0.5;
    text-decoration: line-through;
  }

  @media (prefers-color-scheme: dark) {
    .sold-badge {
      background-color: rgba(255, 255, 255, 0.9);
      color: black;
    }
  }

  @media (max-width: 768px) {
    .artwork-info h3 {
      font-size: 1rem;
    }

    .artwork-meta {
      font-size: 0.8rem;
    }

    .artwork-price {
      font-size: 0.95rem;
    }

    .sold-badge {
      font-size: 0.8rem;
      padding: 0.4rem 0.8rem;
    }
  }
</style>