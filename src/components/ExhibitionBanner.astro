---
// src/components/ExhibitionBanner.astro
// ─────────────────────────────────────────────────────────────────────────────
// Full-width feature image for the Ausstellungen page.
// Displays the "Basecamp Alpine Art" lettering image (1050 × 600) as a
// cinematic banner strip — slightly narrower than the full-bleed divider to
// give it a framed, gallery-wall quality.
// ─────────────────────────────────────────────────────────────────────────────
---

<div class="exb-root">

  <!-- Top fade into hero above -->
  <div class="exb-fade exb-fade--top" aria-hidden="true"></div>

  <figure class="exb-figure">
    <div class="exb-frame">
      <img
        src="/images/exhibition/1.png"
        alt="Basecamp Alpine Art – Lettering über einem Gemälde"
        loading="eager"
        decoding="async"
        width="1050"
        height="600"
        class="exb-img"
      />
      <div class="exb-vignette" aria-hidden="true"></div>
    </div>

    <!-- Gold corner accents -->
    <div class="exb-corner exb-corner--tl" aria-hidden="true"></div>
    <div class="exb-corner exb-corner--tr" aria-hidden="true"></div>
    <div class="exb-corner exb-corner--bl" aria-hidden="true"></div>
    <div class="exb-corner exb-corner--br" aria-hidden="true"></div>

    <figcaption class="exb-caption">
      <span class="exb-caption__glyph" aria-hidden="true">✦</span>
      Basecamp Alpine Art
    </figcaption>

  </figure>

  <!-- Bottom fade into section below -->
  <div class="exb-fade exb-fade--bottom" aria-hidden="true"></div>

</div>

<style>
  .exb-root {
    position: relative;
    width: 100%;
    /* Full-width bleed like AboutImageDivider */
    margin-left: calc(-50vw + 50%);
    width: 100vw;
  }

  /* ── Top / bottom gradient fades ── */
  .exb-fade {
    position: absolute;
    left: 0;
    right: 0;
    height: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .exb-fade--top {
    top: 0;
    background: linear-gradient(to bottom, var(--color-bg), transparent);
  }

  .exb-fade--bottom {
    bottom: 0;
    background: linear-gradient(to top, var(--color-bg), transparent);
  }

  .exb-figure {
    position: relative;
    margin: 0;
    margin-top: 20px;
    padding: 0 clamp(1.5rem, 6vw, 6rem); /* inset from edges — gives gallery-frame feel */
  }

  /* ── Image frame ── */
  .exb-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(201,169,110,0.13);
    box-shadow:
      0 28px 70px rgba(0,0,0,0.65),
      0 4px 16px rgba(0,0,0,0.4),
      inset 0 0 0 1px rgba(255,255,255,0.03);
    /* Maintain image ratio but cap height for cinematic feel */
    max-height: clamp(280px, 44vw, 540px);
  }

  .exb-img {
    display: block;
    width: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.78) contrast(1.07) saturate(0.84);
    transform: scale(1.03);
    transition: transform 8s ease, filter 0.7s ease;
  }

  .exb-frame:hover .exb-img {
    transform: scale(1.055);
    filter: brightness(0.84) contrast(1.05) saturate(0.9);
  }

  /* Vignette overlay */
  .exb-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, transparent 45%, rgba(10,10,9,0.5) 100%),
      linear-gradient(to right, rgba(10,10,9,0.3) 0%, transparent 20%, transparent 80%, rgba(10,10,9,0.3) 100%);
    pointer-events: none;
  }

  /* ── Gold corner accents ── */
  .exb-corner {
    z-index: 4;
    position: absolute;
    width: 28px;
    height: 28px;
    pointer-events: none;
    opacity: 0.4;
    /* compensate for the figure padding */
    --pad: clamp(1.5rem, 6vw, 6rem);
  }

  .exb-corner--tl { top: -5px;  left:  calc(var(--pad) - 5px);  border-top: 1px solid var(--color-accent); border-left:  1px solid var(--color-accent); }
  .exb-corner--tr { top: -5px;  right: calc(var(--pad) - 5px);  border-top: 1px solid var(--color-accent); border-right: 1px solid var(--color-accent); }
  .exb-corner--bl { bottom: -5px; left:  calc(var(--pad) - 5px);  border-bottom: 1px solid var(--color-accent); border-left:  1px solid var(--color-accent); }
  .exb-corner--br { bottom: -5px; right: calc(var(--pad) - 5px);  border-bottom: 1px solid var(--color-accent); border-right: 1px solid var(--color-accent); }

  /* ── Caption ── */
  .exb-caption {
    position: absolute;
    bottom: 1rem;
    right: calc(clamp(1.5rem, 6vw, 6rem) + 1.2rem);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.63rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 400;
    color: rgba(201,169,110,0.65);
    text-shadow: 0 1px 4px rgba(0,0,0,0.7);
  }

  .exb-caption__glyph { font-size: 0.48rem; opacity: 0.7; }

  @media (max-width: 640px) {
    .exb-figure { padding: 0 1rem; }
  }
  @media (max-width: 1200px) {
    .exb-img { height: 100%; }
  }
</style>