---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';

const artworks = [
  {
    title: 'Ethereal Dreams',
    image: 'https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?w=800&q=80',
    year: '2024',
    medium: 'Öl auf Leinwand',
    dimensions: '100 × 80 cm',
    category: 'painting',
    price: 2500,
    sold: false
  },
  {
    title: 'Urban Solitude',
    image: 'https://images.unsplash.com/photo-1547826039-bfc35e0f1ea8?w=800&q=80',
    year: '2024',
    medium: 'Acryl',
    dimensions: '120 × 90 cm',
    category: 'painting',
    price: 3200,
    sold: false
  },
  {
    title: 'Abstract Emotions',
    image: 'https://images.unsplash.com/photo-1561214115-f2f134cc4912?w=800&q=80',
    year: '2023',
    medium: 'Mischtechnik',
    dimensions: '90 × 90 cm',
    category: 'abstract',
    price: 1800,
    sold: true
  }
];
---

<Layout title="Art Portfolio - Startseite">
  <section class="hero">
    <h1>Ausgewählte Werke</h1>
    <p class="subtitle">Eine Sammlung von Gemälden, die das Zusammenspiel von Emotion, Farbe und Form erkunden.</p>
  </section>

  <section class="gallery">
    {artworks.map((artwork) => (
      <ArtworkCard {...artwork} />
    ))}
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    margin: 4rem auto 5rem;
    max-width: 700px;
    min-height: 140px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero h1 {
    margin-bottom: 1rem;
  }

  .subtitle {
    font-size: 1.1rem;
    opacity: 0.7;
    line-height: 1.6;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 3rem 2rem;
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .hero {
      margin: 2rem auto 3rem;
    }

    .subtitle {
      font-size: 1rem;
    }

    .gallery {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 2rem 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>