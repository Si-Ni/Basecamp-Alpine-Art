---
// src/pages/werke.astro

import Layout from "../layouts/Layout.astro";
import WerkeHero from "../components/gallery/WerkeHero.astro";
import ArtworkGallery from "../components/gallery/ArtworkGallery";
import { artworks } from "../data/artworks";
---

<Layout
  title="Werke"
  description="Ausgewählte Ölgemälde, Aquarelle und Fotografien."
>
  <WerkeHero />

  <section class="werke-section">
    <ArtworkGallery client:load artworks={artworks} />
  </section>
</Layout>

<style>
  .werke-section {
    padding-bottom: 5rem;
  }
</style>
